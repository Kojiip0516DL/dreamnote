# === dreamnote — LOGIN app credentials (committed template) ===
#
# Used by Next.js's built-in .env loader. Real values live in .env
# (gitignored). Generate AUTH_SECRET and rotate secrets there.
#
# Get these from https://discord.com/developers/applications
#   → pick the LOGIN application (separate from the bot app)
#   → OAuth2 tab → Client ID is public, click "Reset Secret" then copy
#
# Generate AUTH_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Auth.js v5 requires AUTH_DISCORD_ID and AUTH_DISCORD_SECRET to be set
# (its auto-inference reads those names before running any provider
# config). Mirror the values here.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Auth.js v5 env-inference aliases — paste the same values as above
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
