    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
