{
  "name": "dreamnote",
  "version": "0.1.0",
  "private": true,
  "description": "Unlimited-note knowledge app, Obsidian+Notability feel, powered by Discord login",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "postinstall": "node ./patches/fix-auth-core.cjs",
    "cap:android": "cap add android && cap sync android",
