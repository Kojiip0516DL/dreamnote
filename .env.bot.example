# === dreamnote — BOT app credentials (committed template) ===
#
# Real values live in .env.bot (gitignored). Loaded at runtime by
# src/lib/env-bot.ts.
#
# Bot app = https://discord.com/developers/applications → the BOT
# application (separately created from the login app so its powers can
# be revoked independently).
#
# In DreamLand:
#   1. Invite the bot via OAuth URL Generator with scopes=bot and
#      permissions: Manage Roles, Create Instant Invite, View Channels
#   2. Server Settings → Roles → drag the bot's role ABOVE the @member role
#   3. Bot's role → Permissions → confirm "Manage Roles" is enabled

DISCORD_BOT_CLIENT_ID=
DISCORD_BOT_TOKEN=

DREAMLAND_GUILD_ID=1375911911618777168
DREAMLAND_MEMBER_ROLE_ID=
DREAMLAND_INVITE_CHANNEL_URL=https://discord.gg/dreamland